{% for item in lists %}{% set ca = item.c %}
<div class="checklist" data-checklist="{{ ca.checklist.id }}">
  <h3>{{ ca.checklist.title }}</h3>
  <p class="meta">{% if ca.checklist.source_name %}{{ t("Source: {name}", name=ca.checklist.source_name) }} | {% endif %}{{ t("Topic: {topic}", topic=ca.checklist.control_topic) }} | {{ t("Submission: {label} ({status}, submission {number} of this checklist)", label=ca.submission.label, status=ca.submission.status, number=ca.submission.version) }}{% if ca.submission.questions_version is not none %} | {{ t("Answered under template revision {revision}", revision=ca.submission.questions_version) }}{% endif %}</p>
  {% if item.rows %}
  <table class="answers">
    <colgroup><col class="question"><col class="answer">{% if show_scores %}<col class="score">{% endif %}</colgroup>
    <thead><tr><th>{{ t("Question") }}</th><th>{{ t("Answer") }}</th>{% if show_scores %}<th>{{ t("Score") }}</th>{% endif %}</tr></thead>
    <tbody>
    {% for r in item.rows %}<tr><td>{{ r.question }}</td><td>{% if r.answered %}{{ r.answer if r.answer is not none else "" }}{% else %}{{ t("Not answered") }}{% endif %}{% if r.files %}<div class="proof-files"><p class="meta">{{ t("Proof files") }}</p><ul>{% for f in r.files %}<li>{{ f.name }} | {{ f.mime }} | {{ f.size }} | {{ f.uploaded_by if f.uploaded_by else t("uploader not recorded") }} | {{ f.when }}<br><span class="sha256">SHA-256 {{ f.sha256 }}</span></li>{% endfor %}</ul></div>{% endif %}</td>{% if show_scores %}<td>{{ number(r.score) if r.score is not none else "" }}</td>{% endif %}</tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}
  {% if show_scores %}<p class="scores">{% if ca.mean is not none %}{{ t("Mean score {mean}, ", mean=number(ca.mean)) }}{% endif %}{{ t("answered {answered} of {total}", answered=ca.answered, total=ca.total) }}</p>{% endif %}
</div>
{% endfor %}
{% if hidden %}<p class="more">{{ t("and {count} more", count=hidden) }}</p>{% endif %}
